# DRRMO API — copy to .env for local development.
# On Render these are set in the dashboard (see render.yaml / DEPLOYMENT.md).

PORT=5000
NODE_ENV=development

# Local MongoDB, or your Atlas connection string
MONGODB_URI=mongodb://localhost:27017/drrmo

# Use a long random string. Required in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated allowed browser origins (only enforced when NODE_ENV=production).
# Wildcards are supported, e.g. https://drrmo-*.vercel.app
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3003,http://localhost:3005

# Seed demo accounts + sample data at boot, only if the database has no users yet.
SEED_DEMO_DATA=false

# Optional tuning
LOG_LEVEL=info
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=1500
# AUTH_RATE_LIMIT_MAX=20
