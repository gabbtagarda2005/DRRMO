# DRRMO System Environment Configuration

# ============================================
# Backend Server Configuration
# ============================================
NODE_ENV=development
PORT=5000
HOST=localhost

# ============================================
# Database Configuration
# ============================================
MONGODB_URI=mongodb://localhost:27017/drrmo
MONGODB_USER=admin
MONGODB_PASSWORD=your_secure_password_here

# ============================================
# JWT Configuration
# ============================================
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_EXPIRE=7d

# ============================================
# File Upload Configuration
# ============================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800  # 50MB in bytes
ALLOWED_FILE_TYPES=pdf,jpg,jpeg,png,doc,docx,xls,xlsx

# ============================================
# Email Configuration (Optional)
# ============================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_email_password
EMAIL_FROM=noreply@drrmo.gov.ph

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=info
LOG_FILE=./logs/app.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=14d

# ============================================
# Rate Limiting Configuration
# ============================================
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# CORS Configuration
# ============================================
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004

# ============================================
# Admin Frontend (Vite) Configuration
# ============================================
VITE_API_URL=http://localhost:5000
VITE_WS_URL=ws://localhost:5000

# ============================================
# DRRMO Officer Frontend Configuration
# ============================================
VITE_API_URL=http://localhost:5000
VITE_WS_URL=ws://localhost:5000

# ============================================
# Responder App Frontend Configuration
# ============================================
VITE_API_URL=http://localhost:5000
VITE_WS_URL=ws://localhost:5000

# ============================================
# Barangay App Frontend Configuration
# ============================================
VITE_API_URL=http://localhost:5000
VITE_WS_URL=ws://localhost:5000

# ============================================
# Citizen PWA Frontend Configuration
# ============================================
VITE_API_URL=http://localhost:5000
VITE_WS_URL=ws://localhost:5000
